{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forma.local/benchmark_case.schema.json",
  "title": "FORMA normalised benchmark case",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "forma_case_id",
    "source_family_id",
    "source_id",
    "source_task_id",
    "source_task_locator",
    "source_version_or_retrieval_date",
    "license_status",
    "domain",
    "provenance_class",
    "source_task_summary",
    "principals_and_roles",
    "source_assertions_or_policy",
    "mapped_invariant",
    "named_checker",
    "evidence_items",
    "disclosure_model",
    "oracle_basis",
    "oracle_status",
    "mapping_assumptions",
    "coding_status",
    "coder_1",
    "coder_2",
    "adjudication_note",
    "eligible_for_fa_fr_metrics",
    "parent_source_anchor_id",
    "configuration_id",
    "derived_from_source"
  ],
  "properties": {
    "forma_case_id": {"type": "string", "minLength": 1},
    "source_family_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_task_id": {"type": "string", "minLength": 1},
    "source_task_locator": {"type": "string", "minLength": 1},
    "source_version_or_retrieval_date": {"type": "string", "minLength": 1},
    "license_status": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "provenance_class": {"enum": ["source_anchored", "derived_configuration", "source_grounded_derived_case", "controlled_forma_benchmark_case"]},
    "source_task_summary": {"type": "string", "minLength": 1},
    "principals_and_roles": {"type": "array", "minItems": 2},
    "source_assertions_or_policy": {"type": "string", "minLength": 1},
    "mapped_invariant": {
      "type": "object",
      "required": ["statement"],
      "properties": {"statement": {"type": "string", "minLength": 1}}
    },
    "named_checker": {"type": "string", "minLength": 1},
    "evidence_items": {"type": "array", "minItems": 1},
    "disclosure_model": {"type": "object"},
    "oracle_basis": {"type": "string", "minLength": 1},
    "oracle_status": {"enum": ["available", "partial", "unavailable"]},
    "mapping_assumptions": {"type": "array"},
    "coding_status": {"enum": ["candidate", "independently_coded", "adjudicated"]},
    "coder_1": {"type": "string"},
    "coder_2": {"type": "string"},
    "adjudication_note": {"type": "string"},
    "eligible_for_fa_fr_metrics": {"type": "boolean"},
    "parent_source_anchor_id": {"type": "string"},
    "configuration_id": {"enum": ["S0", "S1", "S2", "S3", "S4"]},
    "derived_from_source": {"type": "boolean"},
    "tactic_applicability": {"enum": ["unknown", "applicable", "not_applicable"]},
    "trust_assumptions": {"type": "array", "items": {"type": "string"}},
    "alterations": {"type": "array"}
  }
}
